# =====================================================================
# AeroGuard - Environment Configuration
# AssemblyAI Voice Agent Hackathon on Lablab.ai
# =====================================================================

# AssemblyAI API Key (Mandatory for live streaming STT & LLM Gateway)
# Strict technical requirement: Header format 'Authorization: <KEY>' (NO Bearer prefix for streaming)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Server Network Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Airfield / Acoustic Processing Parameters
AIRPORT_ICAO=KORD
SAMPLE_RATE=16000
AUDIO_ENCODING=pcm_s16le
MIN_TURN_SILENCE=400
MAX_TURN_SILENCE=1200

# LLM Gateway Settings for FAA Part 139 Digital Incident Audit
LLM_GATEWAY_URL=https://llm-gateway.assemblyai.com/v1/chat/completions
LLM_MODEL=claude-3-5-sonnet
